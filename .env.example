# ============================================================
# エリアスコア 環境変数サンプル
#   このファイルをコピーして .env.local を作成し、実際の値を設定する。
#   .env.local はコミットしないこと（.gitignore 済み）。値はすべてプレースホルダ。
#   ※ 実際のキーは貼らないこと（GitHub Push Protection に検知されます）。
# ============================================================

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role キー（サーバー専用・RLS をバイパス。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_your_starter_price_id
NEXT_PUBLIC_STRIPE_STANDARD_PRICE_ID=price_your_standard_price_id

# ── 機能フラグ ──
# 駅単位データの利用可否マスター（'true' で有効）
NEXT_PUBLIC_FEATURE_STATION_LEVEL=false
# 相場・公示価格データの利用可否マスター（'true' で有効）
NEXT_PUBLIC_FEATURE_MARKET_METRICS=false
# Google Sheets 出力ボタンの表示マスター（'true' で有効・Standard 以上に表示）
NEXT_PUBLIC_FEATURE_SHEETS_EXPORT=false

# ── Google Sheets 連携（Sheets 出力・すべてサーバー専用） ──
# Google Cloud Console の OAuth 2.0 クライアント（種類: ウェブアプリケーション）。
# スコープは drive.file のみ（アプリが作成したファイルのみアクセス可）。
# ※ NEXT_PUBLIC_ を付けないこと（クライアントに露出させない）。
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# 承認済みリダイレクト URI（Console 側の設定と完全一致させる）。
# 例: http://localhost:3000/api/integrations/google/callback
#     https://area-score-app.vercel.app/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# 連携トークン暗号化鍵（base64 の 32 バイト）。生成: openssl rand -base64 32
INTEGRATIONS_TOKEN_KEY=your-base64-encoded-32-byte-key

# ── お問い合わせ通知（Resend / ベストエフォート） ──
# RESEND_API_KEY と INQUIRY_NOTIFY_EMAIL が未設定でも、
# お問い合わせの DB 保存は成功する（メール通知のみスキップされる）。
RESEND_API_KEY=re_your_resend_api_key_here
# 通知メールの宛先（運営の受信用アドレス）
INQUIRY_NOTIFY_EMAIL=sales@example.com
# 通知メールの送信元（Resend で検証済みドメインのアドレス。未設定なら onboarding@resend.dev）
INQUIRY_FROM_EMAIL=エリアスコア <noreply@example.com>
